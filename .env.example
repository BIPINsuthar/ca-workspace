# ─────────────────────────────────────────────────────────────
#  CA Workspace Manager — environment variables
#  Copy this file to `.env` and fill in your own values.
#  NEVER commit `.env` to GitHub (it is already in .gitignore).
# ─────────────────────────────────────────────────────────────

# 1) DATABASE (PostgreSQL) ─ from Neon or Supabase (see README → "Accounts")
#    Pooled connection string (used by the app):
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
#    Direct (non-pooled) connection string (used for creating tables).
#    On Neon: same string WITHOUT "-pooler" in the host.
#    On Supabase: the "Direct connection" / port 5432 string.
#    If you only have one string, paste the same value in both.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# 2) LOGIN SECURITY ─ a long random secret used to sign login sessions.
#    Generate one with:  openssl rand -base64 32
#    (or any 40+ character random text). Changing it logs everyone out.
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-characters"

# 3) FIRM DETAILS ─ shown in the sidebar and browser tab
FIRM_NAME="LedgerPulse"
FIRM_TAGLINE="CA Workspace Manager"

# 4) FIRST ADMIN ACCOUNT ─ created when you run `npm run db:seed`.
#    Log in with these, then change the password from "My profile".
SEED_ADMIN_NAME="Firm Admin"
SEED_ADMIN_EMAIL="admin@cafirm.in"
SEED_ADMIN_PASSWORD="Admin@123"

# 5) DEMO DATA ─ "true" adds sample clients, employees and tasks
#    (rahul@cafirm.in / priya@cafirm.in / arjun@cafirm.in, password Employee@123).
#    Use "false" for your real, clean workspace.
SEED_DEMO="false"
